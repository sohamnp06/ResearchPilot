# ResearchPilot — Environment Variables
# Copy this file to .env and fill in your values.

# ─────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────
APP_NAME=ResearchPilot
DEBUG=True

HOST=127.0.0.1
PORT=8000

# ─────────────────────────────────────────
# DATABASE (SQLite default, set PostgreSQL URL for production)
# ─────────────────────────────────────────
DATABASE_URL=your_supabase_postgresql_connection_string

# ─────────────────────────────────────────
# SECURITY — CHANGE THIS IN PRODUCTION
# ─────────────────────────────────────────
secret_key=your_secret_key

# ─────────────────────────────────────────
# MAIL (optional — verification codes print to logs if not set)
# ─────────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@researchpilot.local

# ─────────────────────────────────────────
# STORAGE
# ─────────────────────────────────────────
CACHE_DIR=data/cache
PAPER_DIR=data/papers
FAISS_STORAGE_PATH=data/faiss_index

# ─────────────────────────────────────────
# SEMANTIC SCHOLAR (primary paper discovery API)
# Get your key at: https://www.semanticscholar.org/product/api
# ─────────────────────────────────────────
SEMANTIC_SCHOLAR_API=your_api
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key

# ─────────────────────────────────────────
# ARXIV (secondary/fallback — no key required)
# ─────────────────────────────────────────
ARXIV_API=arxiv_api

# ─────────────────────────────────────────
# ─────────────────────────────────────────
# LLM — OPENROUTER / CLOUD
# ─────────────────────────────────────────
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct

# Optional Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=

# ─────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────
LOG_LEVEL=INFO

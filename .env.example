# ResearchPilot — Environment Variables
# Copy this file to .env and fill in your values.

# ─────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────
APP_NAME=ResearchPilot
DEBUG=True

HOST=127.0.0.1
PORT=8000

# ─────────────────────────────────────────
# DATABASE (SQLite default, set PostgreSQL URL for production)
# ─────────────────────────────────────────
DATABASE_URL=sqlite:///./backend/research_assistant.db

# ─────────────────────────────────────────
# SECURITY — CHANGE THIS IN PRODUCTION
# ─────────────────────────────────────────
secret_key=researchpilot-dev-secret-key-change-in-production

# ─────────────────────────────────────────
# MAIL (optional — verification codes print to logs if not set)
# ─────────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@researchpilot.local

# ─────────────────────────────────────────
# STORAGE
# ─────────────────────────────────────────
CACHE_DIR=data/cache
PAPER_DIR=data/papers
FAISS_STORAGE_PATH=data/faiss_index

# ─────────────────────────────────────────
# SEMANTIC SCHOLAR (primary paper discovery API)
# Get your key at: https://www.semanticscholar.org/product/api
# ─────────────────────────────────────────
SEMANTIC_SCHOLAR_API=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# ─────────────────────────────────────────
# ARXIV (secondary/fallback — no key required)
# ─────────────────────────────────────────
ARXIV_API=https://export.arxiv.org/api/query

# ─────────────────────────────────────────
# LLM — LOCAL (Ollama with llama3.2)
# Install Ollama: https://ollama.com
# Then run: ollama pull llama3.2
# ─────────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─────────────────────────────────────────
# LLM — HOSTED (OpenAI, optional future use)
# ─────────────────────────────────────────
OPENAI_API_KEY=

# ─────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────
LOG_LEVEL=INFO
